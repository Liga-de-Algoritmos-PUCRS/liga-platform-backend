# Modelo das variaveis de ambiente. Copie para .env (desenvolvimento) ou
# .env.prod (producao, no servidor) e preencha os valores.
#
# As chaves abaixo, com excecao de PORT, DB_USER e DB_PASSWORD, sao validadas
# por zod em src/global/env.schema.ts: faltando qualquer uma, a aplicacao nao
# sobe. Chave nova obrigatoria precisa entrar no schema e aqui.

# 'development' ou 'production'. Em production o /docs e o /api-json (spec
# OpenAPI completo, inclusive rotas admin) deixam de ser expostos.
NODE_ENV=

# Porta em que o Nest escuta. Opcional: sem ela, 3000. Em producao deixe vazia
# ou 3000 -- o nginx faz proxy para "api:3000" (set $upstream em
# nginx/default.conf). Mudar so aqui derruba a API em 502.
PORT=

#
# Banco de dados
#
# Em producao o host e "postgres" (nome do servico no compose) e o banco e
# liga_db: postgresql://<user>:<senha>@postgres:5432/liga_db
DATABASE_URL=

# Usadas APENAS pela interpolacao ${...} do docker-compose.prod.yaml, para
# criar o usuario do postgres. A aplicacao nao le nenhuma das duas. Como
# env_file nao alimenta interpolacao, elas so chegam ao compose via
# `--env-file` (ver DEPLOY.md); sem elas o postgres sobe sem usuario.
DB_USER=
DB_PASSWORD=

#
# Tokens
#
# ACCESS_TOKEN_SECRET e REFRESH_TOKEN_SECRET precisam ser DIFERENTES entre si:
# com o mesmo valor os dois JWTs viram intercambiaveis.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRATION=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=

#
# AWS S3 (upload de arquivos)
#
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=
BUCKET_NAME=

#
# AWS SES (envio de e-mail)
#
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
SES_SENDER_EMAIL=
SES_SENDER_NAME=

#
# CORS: lista de origens separadas por virgula (whitelist explicita).
#
CORS=
